# Local cache for summary intermediates (transcripts fetched from B 站,
# kept on disk so summarize() can read the file path instead of stuffing
# the full text into a ReAct Action Input — see R5-C 2026-07-26)
data/cache/
# Local settings.json may carry secrets (kimi_api_key etc.) — never tracked
data/settings.json
# Whole data/ dir is local-only (SQLite + transcripts cache + downloads +
# scripts + secrets-bearing settings). Sub-files above also ignored
# individually; this top-level entry suppresses "?? data/" in git status.
data/

# Local Claude/ECC configuration and drafts
.claude/
docs/_build/

# Screenshots: docs/.screenshots 下的图片默认不提交；
# 如需保留特定证据，请显式 `git add -f docs/.screenshots/<file>`
docs/.screenshots/
# 验收上传证据: 已 tracked 历史图保留; 新的 verifier 截图默认忽略,
# 需要保留请 `git add -f docs/superpowers/verifications/<file>.png`
docs/superpowers/verifications/*.png

# 顶层临时调试截图（与 web-*.png 同风格） — 默认不入库
